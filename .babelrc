{
  "ignore": ["/node_modules/"],
  "presets": [
      [
        "@babel/preset-env", {
          "targets": {
            "browsers": "defaults"
          },
          "useBuiltIns": "usage",
          "corejs": {
            "version": 3,
            "proposals": true
          }
        }
      ],
      "@babel/preset-react",
      "@babel/preset-typescript"
  ],
  "plugins": [
      "@babel/plugin-transform-runtime"
  ]
}
