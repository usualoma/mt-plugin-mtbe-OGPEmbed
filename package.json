{
  "name": "mt-plugin-mtblockeditor",
  "version": "1.0.0",
  "description": "This is a plugin for the Movable Type. This plugin provides block editor block types for embed other site by OGP infomation.",
  "scripts": {
    "build": "vite build",
    "start": "vite build --watch --mode development",
    "check-types": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "author": "tamano@sixapart.com",
  "license": "",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bootstrap": "^5.0.1",
    "@types/i18next": "^13.0.0",
    "@types/jquery": "^3.5.5",
    "@types/jqueryui": "^1.12.13",
    "@types/node": "^22.20.1",
    "@types/react": "^16.9.35",
    "@types/tinymce": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "jquery": "^3.7.1",
    "jsdom": "^27.4.0",
    "mt-block-editor-block": "^1.1.3",
    "prettier": "^2.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
